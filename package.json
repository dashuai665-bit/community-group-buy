{
  "name": "linli-coucou",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:staging": "node scripts/build-worker.mjs staging",
    "build:production": "node scripts/build-worker.mjs production",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app db domain lib server tests scripts proxy.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:repository && pnpm run test:http && pnpm run test:concurrency && pnpm run test:reconciliation",
    "test:unit": "node --test tests/homepage.test.mjs tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:repository": "node --test tests/repository/*.test.mjs",
    "test:http": "node --test tests/http/*.test.mjs",
    "test:concurrency": "node --test tests/concurrency/*.test.mjs",
    "test:reconciliation": "node --test tests/reconciliation/*.test.mjs",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "db:verify": "node --test tests/integration/schema.test.mjs",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local",
    "db:migrations:apply:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:list:staging": "wrangler d1 migrations list DB --remote --env staging",
    "db:migrations:apply:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrations:list:production": "wrangler d1 migrations list DB --remote --env production",
    "infra:verify": "node scripts/verify-wrangler-local-d1.mjs && node --test tests/integration/canonical-equivalence.test.mjs tests/integration/canonical-invariants.test.mjs tests/unit/production-infrastructure.test.mjs",
    "predeploy:check": "node scripts/check-production-config.mjs",
    "bootstrap:platform-admin": "node scripts/bootstrap-platform-admin.mjs",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
